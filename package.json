{
  "name": "paintor",
  "version": "2.2.2",
  "author": {
    "name": "AseasRoa"
  },
  "description": "100% JavaScript view library for the browser and for the server",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "main": "./lib/index.js",
  "browser": "./dist/bundle.js",
  "exports": {
    "types": "./types/index.d.ts",
    "browser": "./dist/bundle.js",
    "import": "./lib/index.js",
    "default": "./lib/index.js"
  },
  "imports": {
    "#paintor": {
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "check": "npm run check:tsc & npm run check:oxlint & npm run check:dpdm -- --no-warning --no-tree",
    "check:oxlint": "oxlint --format=stylish",
    "check:tsc": "tsc --noEmit",
    "check:dpdm": "dpdm --exit-code circular:1 ./lib/index.js",
    "depencency-graph": "npx depcruise lib --output-type archi | dot -T svg > dependency-graph.svg",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "dpdm": "^4.2.0",
    "jsdom": "^30.0.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AseasRoa/paintor.git"
  },
  "homepage": "https://aseasroa.github.io/paintor",
  "keywords": [
    "frontend",
    "backend",
    "templates",
    "components",
    "ui",
    "view",
    "vanilla",
    "hyperscript",
    "reactive"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
